<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns all in-app theming; this XML theme only controls the window before
      the first frame. A dark window background avoids a white flash on launch.
    -->
    <style name="Theme.PortalRemote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
