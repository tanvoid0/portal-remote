<?xml version="1.0" encoding="utf-8"?>
<!--
  The desktop server speaks plain HTTP on the local network, so cleartext has to be
  permitted. It cannot be scoped to the private ranges: <domain> matches host names
  literally and has no CIDR support, so a "192.168.0.0/16" entry silently matches
  nothing and every real LAN address is refused. The server's address is whatever
  the user paired with, so the permission has to be blanket.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
