<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ reads this instead of android:allowBackup. Both halves are excluded, not
  just the cloud one: cloud-backup is Google Drive, device-transfer is the
  phone-to-phone copy during setup, and the pairing token should not survive either.
  See the comment on <application> in AndroidManifest.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
