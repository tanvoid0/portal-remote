<!--
  Portal Remote brand mark — see docs/design-system.md §11.
  A display with a phone-shaped opening punched through it: the phone is the way
  into the PC. Drawn on a 24-unit grid; the launcher icon (ic_launcher_foreground)
  and the desktop server (Theme/BrandMark.cs) use the same geometry scaled up.
  The opening is a real hole (evenOdd), so the mark works in a single tint and as
  an Android monochrome/themed icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Untinted black: every use site is a Compose Icon(), which applies its own tint. -->

    <!-- Display body with the phone-shaped portal knocked out. -->
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M4.5,3 h15 a3,3 0 0 1 3,3 v9 a3,3 0 0 1 -3,3 h-15 a3,3 0 0 1 -3,-3 v-9 a3,3 0 0 1 3,-3 z
                          M11,6 h2 a1.5,1.5 0 0 1 1.5,1.5 v6 a1.5,1.5 0 0 1 -1.5,1.5 h-2 a1.5,1.5 0 0 1 -1.5,-1.5 v-6 a1.5,1.5 0 0 1 1.5,-1.5 z" />

    <!-- Stand: kept as a separate path so its overlap with the body doesn't
         become a second evenOdd hole. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M10.5,17.5 h3 v3 h-3 z
                          M8.25,20 h7.5 a1.25,1.25 0 0 1 0,2.5 h-7.5 a1.25,1.25 0 0 1 0,-2.5 z" />
</vector>
