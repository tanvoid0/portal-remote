<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ gates notifications behind a runtime grant; asked for on the
         Share tab, which is the only place that posts any. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- DownloadManager needs this to write to the public Downloads folder on
         Android 9 (API 28) and below; scoped storage makes it unnecessary from
         Android 10 onward, hence the cap. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Settings → Updates hands the downloaded APK to the system installer. There is
         no Play Store behind a sideloaded build, so without this it cannot update
         itself. The user still confirms the install, and on API 26+ still has to
         grant this app the "install unknown apps" toggle. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Playing the PC's sound here outlives the screen that started it — a speaker that
         stops when the phone locks is not a speaker — so it runs as a foreground service
         and the system is told what kind. Android 14+ requires the typed permission as
         well as the generic one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Wi-Fi power save parks the radio between packets with the screen off, which on a
         constant-rate audio stream is audible as dropouts. WifiLock is what holds it
         open; the lock is taken only while something is playing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.PortalRemote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PortalRemote"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The whole point of quick share: Portal Remote shows up in the system
                 share sheet of every app, so sending a link or a screenshot to the PC
                 is two taps from wherever you already are, not a trip into this app.
                 singleTop above so sharing into an already-open session lands in
                 onNewIntent instead of building a second copy of the activity. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Anything, not just text and images: the server side is the same
                     multipart upload either way, and a share target that refuses the
                     PDF you were looking at is the one you stop reaching for. -->
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Not exported: it is started by this app's own Media tab and by the Stop
             action on its own notification, and nothing else has any business making
             this phone play a stranger's PC. -->
        <service
            android:name=".audio.SpeakerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Only the update APK goes through here (see @xml/file_paths): the installer
             is a different process, so it needs a content:// URI it has been granted
             rather than a file:// path it cannot read. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
